# EduVault backend - example environment. Copy to `.env` and fill in; never commit `.env`.
# Every key below is optional unless marked REQUIRED; defaults live in config/settings.py.

# --- Secrets (REQUIRED). Use long random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_SIGNING_KEY=

# --- Core ---
DEBUG=False
ALLOWED_HOSTS=api.example.com

# --- Database. Production: PostgreSQL. Local development may use SQLite: sqlite:///db.sqlite3
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/eduvault
# Seconds to wait for PostgreSQL before failing (default 10)
# DB_CONNECT_TIMEOUT=10

# --- Cache (sessions, lockout, OTP codes). Production must use Redis; locmemcache:// is for local development only
REDIS_URL=redis://HOST:6379/1

# --- Frontend ---
CORS_ALLOWED_ORIGINS=https://localhost:3000/
FRONTEND_URL=https://localhost:3000/
# Extra CORS request headers (comma separated). Behind an ngrok tunnel: ngrok-skip-browser-warning
# CORS_EXTRA_ALLOW_HEADERS=
# Hostnames on which the Django admin site (/admin/) is served; any other Host gets 404. Default: localhost, 127.0.0.1, [::1]
# DJANGO_ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
# LAN testing on the same Wi-Fi (run: python manage.py runserver 0.0.0.0:8000): add the PC's IPv4 to BOTH lists, e.g.
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.168
#   DJANGO_ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.0.168
# CORS_ALLOWED_ORIGINS only needs the LAN frontend origin (e.g. http://192.168.0.50:3000) if a browser app is served from another device.
# Set True only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=False

# --- Email (OTP codes, notifications). Development: console backend prints messages to the server console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP (Gmail example): EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Gmail needs 2-step verification and a 16-character App Password (never your normal password). Put the real values in
# backend/.env (git-ignored), never in this file.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# --- OTP / registration ---
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Minimum seconds between two OTP e-mails to the same address (0 disables)
OTP_RESEND_COOLDOWN_SECONDS=60
# How long a verified e-mail may be used to finish registration
REGISTRATION_VERIFICATION_SECONDS=1800
REGISTRATION_REQUIRES_APPROVAL=True
EMAIL_NOTIFICATIONS_ENABLED=True
PASSWORD_MIN_LENGTH=8

# --- Sessions and lockout ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_INACTIVITY_SECONDS=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Rate limits ---
THROTTLE_ANON=60/minute
THROTTLE_USER=600/minute
THROTTLE_REGISTER=10/hour
THROTTLE_OTP=10/hour
THROTTLE_OTP_VERIFY=30/hour
THROTTLE_LOGIN=20/minute
THROTTLE_TWO_FACTOR=20/minute
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_VIEWER=180/minute
THROTTLE_CHECKOUT=20/hour
THROTTLE_WEBHOOK=600/minute

# --- Admin 2FA: first-time enrolment needs a one-time code from `python manage.py issue_admin_2fa_enrollment <email>`
# Admin API sign-in code (e-mailed, valid 30 s - fixed): failed tries before it is burned, seconds between two codes, codes per hour.
ADMIN_LOGIN_OTP_MAX_ATTEMPTS=3
ADMIN_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=10
ADMIN_LOGIN_OTP_MAX_PER_HOUR=10

# --- Private PDF storage: local or s3
STORAGE_BACKEND=local
RESOURCE_MAX_BYTES=52428800
RESOURCE_MAX_PAGES=2000
VIEWER_RENDER_WIDTH=1200
VIEWER_JPEG_QUALITY=80

# --- Stripe: TEST-mode keys only while developing. Leave empty to disable checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=True

# --- Encryption key for TOTP seeds and backup-code hashes.
# REQUIRED when DEBUG=False. Keep it stable across deployments.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
