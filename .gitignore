# ==============================================================================
# EduVault - Root .gitignore
# ==============================================================================

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Databases and storage
db.sqlite3
*.sqlite3
*.sqlite3-journal
media/
staticfiles/
private_media/

# Node / Frontend
node_modules/
.next/
dist/
out/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.vercel
*.tsbuildinfo

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary and backup files
*.tmp
*.temp
*.bak
