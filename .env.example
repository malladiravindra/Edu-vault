# ==============================================================================
# EduVault - Root Environment Variables Template (.env.example)
# Copy to `.env` (backend) or `.env.local` (frontend) as needed.
# NEVER commit real `.env` or `.env.local` files containing secrets.
# ==============================================================================

# --- Backend Security Keys (REQUIRED) ---
SECRET_KEY=replace-me
JWT_SIGNING_KEY=replace-me
FIELD_ENCRYPTION_KEY=replace-me

# --- Core Configuration ---
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
DJANGO_ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Local SQLite: sqlite:///db.sqlite3
# Production PostgreSQL: postgres://USER:replace-me@localhost:5432/eduvault
DATABASE_URL=sqlite:///db.sqlite3

# --- Cache ---
# Local: locmemcache:// | Production: redis://localhost:6379/1
REDIS_URL=locmemcache://

# --- Frontend & CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HEADERS=False

# --- Email (SMTP / Verification / OTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me@gmail.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# --- OTP & Authentication Policy ---
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_LOGIN_OTP_SECONDS=300
ADMIN_LOGIN_OTP_MAX_ATTEMPTS=3
PASSWORD_MIN_LENGTH=10
REGISTRATION_REQUIRES_APPROVAL=True
EMAIL_NOTIFICATIONS_ENABLED=True

# --- Payments (Stripe) ---
PAYMENTS_ENABLED=True
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me

# --- Private Storage (PDFs) ---
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=replace-me

# --- Frontend (Next.js) Variables ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_USE_MOCK_API=false
