# Copy to .env.local and adjust.
# Everything prefixed NEXT_PUBLIC_ is shipped to the browser — never put secrets here.

# Base URL of the EduVault REST API (no trailing slash, no /v1).
# For local development:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# For LAN testing (same Wi-Fi):
# NEXT_PUBLIC_API_BASE_URL=http://192.168.0.168:8000/api

# Always false (mock API is disabled; all business data comes from Django).
NEXT_PUBLIC_USE_MOCK_API=false
